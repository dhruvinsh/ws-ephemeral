WS_USERNAME=xxxx
WS_PASSWORD=xxxx
WS_TOTP=xxxxxxxx
WS_DEBUG=False
WS_COOKIE_PATH=/some/mounted/volume/
QBIT_USERNAME=xxxx
QBIT_PASSWORD=xxxx
# QBIT_API_KEY=qbt_replace_with_api_key
